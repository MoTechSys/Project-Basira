# Copy to .env (git-ignored). Never commit a real token.
TELEGRAM_BOT_TOKEN=            # from @BotFather
BASIRA_API_URL=https://basirapp.site   # or http://basira:8000 inside docker compose
BASIRA_WEB_URL=https://basirapp.site
BASIRA_EVAL_KEY=               # optional, sent as X-Eval-Key
BOT_RATE_PER_MIN=10            # per user, in memory
MAX_TEXT=5000
# Webhook mode (optional; polling when empty)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
PORT=8080
