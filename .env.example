# Basira — Environment Variables Template
# Copy to .env and fill in actual values. Never commit .env.

# ────────────────────────────────────────────
# Backend
# ────────────────────────────────────────────
BASIRA_HOST=0.0.0.0
BASIRA_PORT=8000
BASIRA_LOG_LEVEL=info

# Rate limiting (requests per minute per IP)
BASIRA_RATE_LIMIT=30

# ────────────────────────────────────────────
# LLM Provider (for extraction only, no generation)
# ────────────────────────────────────────────
# Choose one of: mock | openai-compat
BASIRA_LLM_PROVIDER=mock

# When using openai-compat:
# BASIRA_LLM_API_KEY=sk-...
# BASIRA_LLM_BASE_URL=https://api.openai.com/v1
# BASIRA_LLM_MODEL=gpt-4o-mini

# ────────────────────────────────────────────
# Vision Provider (OCR for images)
# ────────────────────────────────────────────
BASIRA_VISION_PROVIDER=mock

# ────────────────────────────────────────────
# Corpus data paths
# ────────────────────────────────────────────
BASIRA_CORPUS_DIR=./corpus/data
BASIRA_SNAPSHOT_DIR=./corpus/snapshot

# 2026-10-06 — final-day additions
# BASIRA_MAX_INPUT bytes limit for /check (guard.py reads this)
BASIRA_MAX_INPUT=32768

# Hash of currently expected corpus manifest (devops verifies in CI)
BASIRA_MANIFEST_SHA=
