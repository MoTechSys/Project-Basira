# Basira — all settings are optional; defaults run fully offline (D-004).
LLM_PROVIDER=mock            # mock | openai-compatible (competition day)
VISION_PROVIDER=mock
HADEETHENC_MODE=link         # link | embed   (owner Q2)
OHD_MODE=display             # display | off  (kill-switch, owner Q4)
RETRIEVAL_VECTORS=off
BASIRA_MAX_TEXT_CHARS=5000
BASIRA_RATE_LIMIT_PER_MIN=30
BASIRA_EVAL_KEY=             # X-Eval-Key header bypass for eval runs (T5)
BASIRA_CORS_ORIGINS=http://localhost:5173
BUILD_SHA=dev
# BASIRA_INDEX_DIR=corpus/index
