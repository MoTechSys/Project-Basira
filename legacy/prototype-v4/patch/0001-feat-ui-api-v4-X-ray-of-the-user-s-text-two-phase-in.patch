diff --git a/backend/tests/test_precision.py b/backend/tests/test_precision.py
index 68b79a2..68e029f 100644
--- a/backend/tests/test_precision.py
+++ b/backend/tests/test_precision.py
@@ -122,3 +122,44 @@ async def test_orthographic_typo_gets_letter_level_highlight(pipeline: Pipeline)
     assert q.status == "needs_review"
     letters = [lt for m in q.matches for op in m.diff for lt in op.quote_letters]
     assert letters, "char-by-char highlight expected inside «علي»"
+
+
+# ---------------------------------------------------------------- two-phase: fast extraction
+
+
+class _CountingLLM:
+    """Wraps the pipeline's provider and counts calls (the fast phase must make none)."""
+
+    def __init__(self, inner: object) -> None:
+        self.inner = inner
+        self.name = getattr(inner, "name", "mock")
+        self.calls = 0
+
+    async def extract(self, text: str) -> object:
+        self.calls += 1
+        return await self.inner.extract(text)  # type: ignore[attr-defined]
+
+
+async def test_fast_phase_skips_model_and_keeps_decisions(pipeline: Pipeline) -> None:
+    """`options.extract="fast"` never calls the provider; any quote both phases find gets the same status."""
+    from app.schemas import CheckOptions  # noqa: PLC0415
+
+    text = "قال تعالى: ﴿إن الله علي كل شيء قدير﴾ وقال ﷺ «إنما الأعمال بالنيات» رواه البخاري"
+    orig = pipeline.llm
+    spy = _CountingLLM(orig)
+    pipeline.llm = spy  # type: ignore[assignment]
+    try:
+        fast = await pipeline.check(CheckRequest(text=text, options=CheckOptions(extract="fast")))
+        assert spy.calls == 0
+        full = await pipeline.check(CheckRequest(text=text))
+        assert spy.calls == 1
+    finally:
+        pipeline.llm = orig
+    assert fast.phase == "fast"
+    assert full.phase == "full"
+    assert fast.extraction_provider == "rules"
+    assert not fast.extraction_degraded
+    by_span = {(q.span.start, q.span.end): q.status for q in full.quotes}
+    for q in fast.quotes:
+        assert by_span.get((q.span.start, q.span.end), q.status) == q.status
+    assert len(fast.quotes) >= 1  # marked quotes are found by the rules alone
